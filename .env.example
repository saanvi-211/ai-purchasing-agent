# ── AI Purchasing Agent ──────────────────────────────────────────────────────
# The agent runs fully WITHOUT any API key: a deterministic rule-based brain
# performs the same investigation → decision → action → validation loop.
# Set the variables below to enable the LLM brain instead (any
# OpenAI-compatible provider works).

# Required for the LLM brain
OPENAI_API_KEY=

# Optional — defaults shown. Point BASE_URL at OpenAI, Azure OpenAI gateways,
# OpenRouter, Groq, LM Studio, Ollama, etc.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional — port for the backend server (frontend dev proxies to it)
PORT=8080
